{
  "$defs": {
    "CatalogMetadata": {
      "additionalProperties": false,
      "properties": {
        "last_verified_at": {
          "format": "date-time",
          "title": "Last Verified At",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "profile_version",
        "valid_from",
        "last_verified_at",
        "sources"
      ],
      "title": "CatalogMetadata",
      "type": "object"
    },
    "ModelCapability": {
      "enum": [
        "text-generation",
        "chat",
        "coding",
        "reasoning",
        "embedding",
        "tool-use"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "ParameterCoverageBand": {
      "additionalProperties": false,
      "properties": {
        "band_id": {
          "minLength": 1,
          "title": "Band Id",
          "type": "string"
        },
        "maximum_parameters": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Parameters"
        },
        "minimum_models": {
          "minimum": 1,
          "title": "Minimum Models",
          "type": "integer"
        },
        "minimum_parameters": {
          "minimum": 0,
          "title": "Minimum Parameters",
          "type": "integer"
        }
      },
      "required": [
        "band_id",
        "minimum_parameters",
        "minimum_models"
      ],
      "title": "ParameterCoverageBand",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "model-coverage",
      "default": "model-coverage",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/CatalogMetadata"
    },
    "minimum_families": {
      "minimum": 1,
      "title": "Minimum Families",
      "type": "integer"
    },
    "minimum_models": {
      "minimum": 1,
      "title": "Minimum Models",
      "type": "integer"
    },
    "parameter_bands": {
      "items": {
        "$ref": "#/$defs/ParameterCoverageBand"
      },
      "minItems": 1,
      "title": "Parameter Bands",
      "type": "array"
    },
    "required_capabilities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelCapability"
      },
      "title": "Required Capabilities",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "minimum_models",
    "minimum_families",
    "parameter_bands"
  ],
  "title": "ModelCoverageTargets",
  "type": "object"
}
