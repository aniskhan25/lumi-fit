{
  "$defs": {
    "ObjectivePlanRank": {
      "additionalProperties": false,
      "properties": {
        "component_contributions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Component Contributions",
          "type": "object"
        },
        "component_weights": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Component Weights",
          "type": "object"
        },
        "composite_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Composite Score"
        },
        "model_id": {
          "pattern": "^.+/.+$",
          "title": "Model Id",
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "rank_change_from_requested": {
          "default": 0,
          "title": "Rank Change From Requested",
          "type": "integer"
        },
        "serving_targets_satisfied": {
          "title": "Serving Targets Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "rank",
        "plan_id",
        "model_id",
        "composite_score",
        "serving_targets_satisfied",
        "component_weights",
        "component_contributions"
      ],
      "title": "ObjectivePlanRank",
      "type": "object"
    },
    "ObjectiveProfile": {
      "enum": [
        "balanced",
        "interactive",
        "throughput",
        "budget",
        "quality-first"
      ],
      "title": "ObjectiveProfile",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "feasible_candidate_count": {
      "minimum": 0,
      "title": "Feasible Candidate Count",
      "type": "integer"
    },
    "objective": {
      "$ref": "#/$defs/ObjectiveProfile"
    },
    "rank_stable_after_excluding_unavailable_components": {
      "title": "Rank Stable After Excluding Unavailable Components",
      "type": "boolean"
    },
    "rankings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectivePlanRank"
      },
      "title": "Rankings",
      "type": "array"
    },
    "unavailable_components": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unavailable Components",
      "type": "array"
    },
    "unavailable_components_excluded": {
      "title": "Unavailable Components Excluded",
      "type": "boolean"
    },
    "winner_changed_from_requested": {
      "title": "Winner Changed From Requested",
      "type": "boolean"
    },
    "winner_plan_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Winner Plan Id"
    }
  },
  "required": [
    "objective",
    "winner_changed_from_requested",
    "feasible_candidate_count",
    "unavailable_components_excluded",
    "rank_stable_after_excluding_unavailable_components"
  ],
  "title": "ObjectiveSensitivity",
  "type": "object"
}
