{
  "$defs": {
    "FeasibilityStatus": {
      "enum": [
        "feasible",
        "conditional",
        "infeasible"
      ],
      "title": "FeasibilityStatus",
      "type": "string"
    },
    "ObjectiveProfile": {
      "enum": [
        "balanced",
        "interactive",
        "throughput",
        "budget",
        "quality-first"
      ],
      "title": "ObjectiveProfile",
      "type": "string"
    },
    "ScoreComponentDelta": {
      "additionalProperties": false,
      "properties": {
        "comparable": {
          "title": "Comparable",
          "type": "boolean"
        },
        "compared_contribution": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Compared Contribution"
        },
        "compared_value": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compared Value"
        },
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "contribution_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Contribution Delta"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "value_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Delta"
        },
        "winner_contribution": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Winner Contribution"
        },
        "winner_value": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winner Value"
        }
      },
      "required": [
        "component_id",
        "winner_contribution",
        "compared_contribution",
        "contribution_delta",
        "comparable",
        "explanation"
      ],
      "title": "ScoreComponentDelta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compared_feasibility": {
      "$ref": "#/$defs/FeasibilityStatus"
    },
    "compared_model_id": {
      "pattern": "^.+/.+$",
      "title": "Compared Model Id",
      "type": "string"
    },
    "compared_plan_id": {
      "minLength": 1,
      "title": "Compared Plan Id",
      "type": "string"
    },
    "compared_rank": {
      "minimum": 2,
      "title": "Compared Rank",
      "type": "integer"
    },
    "compared_targets_satisfied": {
      "title": "Compared Targets Satisfied",
      "type": "boolean"
    },
    "component_deltas": {
      "items": {
        "$ref": "#/$defs/ScoreComponentDelta"
      },
      "title": "Component Deltas",
      "type": "array"
    },
    "decisive_component_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decisive Component Id"
    },
    "decisive_explanation": {
      "minLength": 1,
      "title": "Decisive Explanation",
      "type": "string"
    },
    "decisive_factor": {
      "enum": [
        "feasibility",
        "serving-targets",
        "composite-score",
        "confidence",
        "billing",
        "stable-plan-id"
      ],
      "title": "Decisive Factor",
      "type": "string"
    },
    "gpu_hours_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpu Hours Delta"
    },
    "hbm_headroom_delta_fraction": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hbm Headroom Delta Fraction"
    },
    "memory_safe_concurrency_delta": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Safe Concurrency Delta"
    },
    "objective": {
      "$ref": "#/$defs/ObjectiveProfile"
    },
    "quality_comparable": {
      "title": "Quality Comparable",
      "type": "boolean"
    },
    "quality_explanation": {
      "minLength": 1,
      "title": "Quality Explanation",
      "type": "string"
    },
    "runtime_compatibility_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Compatibility Delta"
    },
    "winner_feasibility": {
      "$ref": "#/$defs/FeasibilityStatus"
    },
    "winner_model_id": {
      "pattern": "^.+/.+$",
      "title": "Winner Model Id",
      "type": "string"
    },
    "winner_plan_id": {
      "minLength": 1,
      "title": "Winner Plan Id",
      "type": "string"
    },
    "winner_rank": {
      "minimum": 1,
      "title": "Winner Rank",
      "type": "integer"
    },
    "winner_targets_satisfied": {
      "title": "Winner Targets Satisfied",
      "type": "boolean"
    }
  },
  "required": [
    "objective",
    "winner_plan_id",
    "compared_plan_id",
    "winner_rank",
    "compared_rank",
    "winner_model_id",
    "compared_model_id",
    "winner_feasibility",
    "compared_feasibility",
    "winner_targets_satisfied",
    "compared_targets_satisfied",
    "component_deltas",
    "quality_comparable",
    "quality_explanation",
    "decisive_factor",
    "decisive_explanation"
  ],
  "title": "PlanComparison",
  "type": "object"
}
